# Ma'lumotlar bazasi
# Development: SQLite (hech narsa o'rnatish shart emas)
DATABASE_URL="file:./dev.db"

# Production: PostgreSQL (docker-compose orqali ishga tushirish tavsiya etiladi)
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hotel_erp"

# JWT kalitlari — kompyuteringizda o'zingiz yarating
JWT_SECRET="your_staff_jwt_secret_here"
JWT_GUEST_SECRET="your_guest_jwt_secret_here"

# Integratsiya maxfiylarini shifrlash uchun kalit (32 bayt, base64)
# Yaratish: openssl rand -base64 32
ENCRYPTION_KEY=""

# To'lov gateway sozlamalari (ixtiyoriy, faqat to'lov ishlashi uchun kerak)
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""

# Server sozlamalari
PORT=5000
